# Speech-to-text, language model and text-to-speech for the example bot.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Where the example listens. Your DIDLogic WebSocket destination points at this
# host over wss://, so it has to be reachable from the public internet.
HOST=0.0.0.0
PORT=8080

# Outbound example only (examples/outbound_bot.py).
# API token from the DIDLogic portal, a five-digit SIP account the call bills
# against, and the public wss:// base the platform should dial back on.
DIDLOGIC_API_TOKEN=
DIDLOGIC_SIP_ACCOUNT=
PUBLIC_WSS_URL=wss://your-tunnel-host

# Optional: sent to your endpoint as `Authorization: Bearer <token>` on the
# WebSocket upgrade, so it can tell our calls from anyone else's.
DIDLOGIC_STREAM_TOKEN=
