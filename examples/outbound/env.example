# AI services
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# didlogic
DIDLOGIC_API_TOKEN=
DIDLOGIC_SIP_ACCOUNT=

# The API to place calls through. Leave unset for production; point it at a
# staging host to test there, and use a token from that environment.
# DIDLOGIC_API_BASE=https://didlogic.com/api/v1

# The public wss:// base the platform dials back on, without a trailing slash
PUBLIC_WSS_URL=wss://your-tunnel-host

# Optional: sent to your endpoint as `Authorization: Bearer <token>` on the
# WebSocket upgrade, so it can tell our calls from anyone else's
DIDLOGIC_STREAM_TOKEN=

# Where the server listens
HOST=0.0.0.0
PORT=8080
